{
  // OpenCode project configuration. See .opencode/README.md for the layout.
  "$schema": "https://opencode.ai/config.json",

  // OpenCode does not read Claude Code's .mcp.json, so its MCP servers are
  // repeated here: chrome-devtools (the brand-site skills) and siruk (the admin
  // API as tools — siruk/mcp_server.py; writes are dry runs unless confirm=true).
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "siruk": {
        "type": "local",
        "command": ["uv", "run", "--quiet", "siruk-mcp"]
      }
    }
  },

  // The Siruk admin has a demo and a production environment. Demo writes are
  // the day-to-day default; anything that talks to production asks first.
  // (During a supervised production run you can answer "Allow always", or
  // lower this rule to "allow" in a local, uncommitted config.)
  "permissions": [
    { "action": "shell", "resource": "*api.siruk.am*", "effect": "ask" }
  ]
}
