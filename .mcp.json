{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "siruk": {
      "command": "uv",
      "args": ["run", "--quiet", "python", "-m", "siruk.mcp_server"]
    },
    "siruk-ops": {
      "command": "uv",
      "args": ["run", "--quiet", "--no-sync", "--project", "${CLAUDE_PROJECT_DIR:-.}", "python", "-m", "siruk.ops_mcp"]
    }
  }
}
