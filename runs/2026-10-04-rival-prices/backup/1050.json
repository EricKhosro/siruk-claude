ibuteId": 3, "attributeName": "Lifestage", "role": "attribute", "valueId": 27, "label": "Adult"}, {"attributeId": 5, "attributeName": "Flavor", "role": "option", "valueId": 36, "label": "Chicken"}, {"attributeId": 8, "attributeName": "Food Texture", "role": "option", "valueId": 139, "label": "Chunks in Gravy"}, {"attributeId": 9, "attributeName": "Packaging Type", "role": "option", "valueId": 148, "label": "Pouch"}]}, {"id": 1344, "name": "Fish in Gravy", "about_this_item": "<p>Complete wet food for adult cats: 75 % meat and animal-derived products in pieces, in a soft pouch.</p>", "ingredient_information": "", "feeding_instructions": "", "sku": "142655", "is_default": false, "sort_order": 5, "sale_mode": "pack", "stock_unit_locked": true, "delete_locked": true, "measure_type": "mass", "item_content": 85000, "content": 85, "pack_count": 1, "price": 300, "compare_at_price": null, "min_allowed_price": null, "cost_price": 170, "last_cost_price": null, "last_cost_at": null, "qty_max": null, "track_inventory": true, "out_of_stock_policy": "deny", "backorder_lead_days": null, "low_stock_threshold": null, "reorder_point": null, "reorder_qty": null, "is_purchasable": true, "stock_status": "in_stock", "available_quantity": 10, "stock_levels": [{"warehouse_id": 1, "warehouse_name": "Main warehouse", "warehouse_type": "own", "on_hand": 10, "allocated": 0, "available": 10}], "suppliers": [], "images": [13912, 13915], "size_label": "85 g", "unit_price": 350, "formatted_unit_price": "350 ֏/100 g", "attribute_values": {"3": [27], "5": [162], "8": [139], "9": [148]}, "attribute_value_labels": [{"attributeId": 3, "attributeName": "Lifestage", "role": "attribute", "valueId": 27, "label": "Adult"}, {"attributeId": 5, "attributeName": "Flavor", "role": "option", "valueId": 162, "label": "Fish"}, {"attributeId": 8, "attributeName": "Food Texture", "role": "option", "valueId": 139, "label": "Chunks in Gravy"}, {"attributeId": 9, "attributeName": "Packaging Type", "role": "option", "valueId": 148, "label": "Pouch"}]}, {"id": 1586, "name": "Liver in Gravy", "about_this_item": "<p>From the pack/benefit card (UA): 75 % meat and animal-origin ingredients in pieces; balanced formula; vitamins, trace elements and amino acids; taurine for sharp eyesight; \"20 років довіри\" (20 years of trust). Pack front: \"З печінкою в ніжному соусі - 75 % м'яса та продуктів тваринного походження в шматочках\".</p>", "ingredient_information": "<p><strong>Composition:</strong> (UA, read off the composition card / back of pack) 75 % м'яса та продуктів тваринного походження в шматочках (4 % з печінки), злаки, мінерали, екстракти рослинного білка, продукти рослинного походження.</p><p><strong>Analytical constituents:</strong> сирий протеїн 7 %, сирий жир 4,5 %, сира зола 2,5 %, сира клітковина 0,3 %, волога 82 %. Енергетична цінність 100 г: 347 kJ (83 kcal).</p><p><strong>Additives:</strong> Поживні кормові добавки (на 1 кг корму): вітамін A (3a672a) 1 042 МО, вітамін D3 (3a671) 167 МО, вітамін E (3a700) 13 mg, вітамін B1 (3a821) 0,83 mg, фолієва кислота (3a316) 0,19 mg, таурин (3a370) 389 mg, холін (холін хлорид 3a890) 0,59 g; цинк (3b605) 5 mg, марганець (3b503) 1 mg, мідь (3b405) 0,4 mg, йод (3b201) 0,2 mg.</p>", "feeding_instructions": "<p>Норми згодовування (pouches per day): adult cat 4 kg - 3,5; pregnant cat - >4; lactating cat - >3,5-4. Opened pouch keeps 48 h refrigerated; introduce gradually over 5-7 days; fresh water always available.</p>", "sku": "142645", "is_default": false, "sort_order": 6, "sale_mode": "pack", "stock_unit_locked": true, "delete_locked": true, "measure_type": "mass", "item_content": 85000, "content": 85, "pack_count": 1, "price": 300, "compare_at_price": null, "min_allowed_price": null, "cost_price": 170, "last_cost_price": null, "last_cost_at": null, "qty_max": null, "track_inventory": true, "out_of_stock_policy": "deny", "backorder_lead_days": null, "low_stock_threshold": null, "reorder_point": null, "reorder_qty": null, "is_purchasable": true, "stock_status": "in_stock", "available_quantity": 10, "stock_levels": [{"warehouse_id": 1, "warehouse_name": "Main warehouse", "warehouse_type": "own", "on_hand": 10, "allocated": 0, "available": 10}], "suppliers": [], "images": [11346, 11349, 11352, 11355, 11358, 11361], "size_label": "85 g", "unit_price": 350, "formatted_unit_price": "350 ֏/100 g", "attribute_values": {"3": [27], "5": [46], "8": [139], "9": [148]}, "attribute_value_labels": [{"attributeId": 3, "attributeName": "Lifestage", "role": "attribute", "valueId": 27, "label": "Adult"}, {"attributeId": 5, "attributeName": "Flavor", "role": "option", "valueId": 46, "label": "Liver"}, {"attributeId": 8, "attributeName": "Food Texture", "role": "option", "valueId": 139, "label": "Chunks in Gravy"}, {"attributeId": 9, "attributeName": "Packaging Type", "role": "option", "valueId": 148, "label": "Pouch"}]}], "createdAt": "2026-09-15T08:49:51.000000Z", "updatedAt": "2026-10-01T11:42:28.000000Z"}